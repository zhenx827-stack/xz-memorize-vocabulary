# DeepSeek 配置（把 sk-xxxxxxxx 换成你的真实 key 即可启用真实模型）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 推荐 deepseek-flash（快）；deepseek-v4-pro 更强但更慢；勿用 deepseek-reasoner
DEEPSEEK_MODEL=deepseek-flash
# 默认关闭 thinking（词卡生成不需要推理链，可明显降延迟）；需要时设为 1
DEEPSEEK_THINKING=0

# 单次请求超时（毫秒），超时自动降级本地词库
DEEPSEEK_TIMEOUT=20000
DEEPSEEK_MAX_TOKENS=2400

PORT=3000
# 词库缓存有效期（毫秒），默认 12 小时
WORD_CACHE_TTL=43200000
